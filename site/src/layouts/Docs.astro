---
import { getCollection } from "astro:content";
import Base from "./Base.astro";
import { href, repo } from "../lib/site";

interface Props {
  title: string;
  description: string;
  /** Collection id of the page being shown, used to mark the current sidebar item and the edit link. */
  id?: string;
}

const { title, description, id } = Astro.props;
const pages = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);

const repoDocs = [
  { label: "README", to: `${repo.url}#readme` },
  { label: "Getting started tutorial", to: `${repo.url}/blob/main/docs/getting-started.md` },
  { label: "Architecture", to: `${repo.url}/blob/main/docs/architecture.md` },
  { label: "Etiquette", to: `${repo.url}/blob/main/docs/etiquette.md` },
  { label: "Excluded projects", to: `${repo.url}/blob/main/docs/excluded-projects.md` },
  { label: "Engine design", to: `${repo.url}/blob/main/packages/engine/docs/design.md` },
  { label: "Contributing", to: `${repo.url}/blob/main/CONTRIBUTING.md` },
  { label: "Security policy", to: `${repo.url}/blob/main/SECURITY.md` },
];
---

<Base title={title} description={description}>
  <div class="wrap docs">
    <aside class="docs__side">
      <nav aria-label="Documentation">
        {/* Labels, not headings: the page's own h1 comes later, and headings before it would break the outline. */}
        <p class="docs__heading"><a href={href("/docs/")} aria-current={id === undefined ? "page" : undefined}>Docs</a></p>
        <ul>
          {
            pages.map((p) => (
              <li>
                <a href={href(`/docs/${p.id}/`)} aria-current={p.id === id ? "page" : undefined}>
                  {p.data.title}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="docs__heading">In the repository</p>
        <ul>
          {
            repoDocs.map((d) => (
              <li>
                <a href={d.to}>{d.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>
    <article class="docs__body prose">
      <slot />
      {
        id && (
          <p class="docs__edit muted">
            <a href={`${repo.url}/edit/main/site/src/content/docs/${id}.md`}>Edit this page on GitHub</a>
          </p>
        )
      }
    </article>
  </div>
</Base>

<style>
  .docs {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: 3rem;
    padding-block: 2rem 5rem;
  }

  .docs__side {
    font-size: 0.95rem;
  }

  .docs__side nav {
    position: sticky;
    top: 1.5rem;
  }

  .docs__heading {
    font-size: 0.9rem;
    font-family: var(--font-sans);
    font-weight: 700;
    color: var(--fg-2);
    margin: 1.5rem 0 0.5rem;
  }

  .docs__heading:first-child {
    margin-top: 0;
  }

  .docs__heading a {
    color: inherit;
    text-decoration: none;
  }

  .docs__side ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--border);
  }

  .docs__side li a {
    display: block;
    padding: 0.3rem 0.85rem;
    margin-left: -2px;
    color: var(--fg);
    text-decoration: none;
    border-left: 2px solid transparent;
  }

  .docs__side li a:hover {
    border-left-color: var(--goblin);
  }

  .docs__side li a[aria-current="page"] {
    border-left-color: var(--fg);
    font-weight: 700;
  }

  .docs__body :global(h1) {
    font-size: clamp(2.2rem, 4vw, 3rem);
    margin-bottom: 0.4em;
  }

  .docs__body :global(h2) {
    font-size: 1.6rem;
    margin-top: 2.2em;
  }

  .docs__body :global(h3) {
    margin-top: 1.8em;
  }

  .docs__body :global(h2 + p),
  .docs__body :global(h3 + p) {
    margin-top: 0;
  }

  .docs__body :global(p:first-of-type) {
    font-size: 1.1rem;
    color: var(--fg-2);
  }

  .docs__body :global(table) {
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }

  .docs__body :global(li) {
    margin-bottom: 0.35em;
  }

  .docs__body :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.25rem 1.25rem;
    border-left: 4px solid var(--loot);
    background: var(--bg-2);
    border-radius: 0 0.5rem 0.5rem 0;
  }

  .docs__edit {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }

  @media (max-width: 48rem) {
    .docs {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .docs__side nav {
      position: static;
    }

    .docs__side ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 0.5rem;
      border-left: 0;
    }

    .docs__side li a {
      margin: 0;
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.3rem 0.8rem;
    }

    .docs__side li a[aria-current="page"] {
      border-color: var(--fg);
    }
  }
</style>
