{
  "name": "gitgoblin",
  "version": "0.1.0",
  "description": "Find open-source projects worth your time, work out what they need, and prepare a pull request you approve",
  "keywords": [
    "open-source",
    "contributing",
    "github",
    "good-first-issue",
    "repository-discovery",
    "cli"
  ],
  "homepage": "https://anandkaranubc.github.io/gitgoblin/",
  "bugs": "https://github.com/anandkaranubc/gitgoblin/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anandkaranubc/gitgoblin.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=24" },
  "bin": { "gitgoblin": "./bin/gitgoblin.mjs" },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bundle": "node scripts/bundle.mjs",
    "prepack": "node scripts/bundle.mjs"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.309"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": { "optional": true }
  },
  "devDependencies": {
    "@gitgoblin/core": "0.1.0",
    "@gitgoblin/discovery": "0.1.0",
    "@gitgoblin/engine": "0.1.0",
    "@gitgoblin/intel": "0.1.0",
    "@gitgoblin/sources": "0.1.0",
    "@types/node": "^24",
    "commander": "^15.0.0",
    "esbuild": "^0.27.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
